# Copy this file to .env for local development.
# Neon dashboard → Connection details → Pooled connection

# DEBUG defaults to off. Keep it on locally; never set it on Render.
DEBUG=True
# Required whenever DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-string

# Leave empty to use local SQLite. Paste your Neon connection string for PostgreSQL.
DATABASE_URL=

# Production-only settings (read when DEBUG is off). Defaults shown.
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=              # e.g. https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=              # only needed for cross-origin admin/forms
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600
# AUTH_THROTTLE_RATE=10/min          # login/register/token, per client IP
# TOKEN_THROTTLE_RATE=30/min         # token refresh + logout
# ADMIN_LOGIN_THROTTLE_RATE=5/min
# CONTENT_BURST_THROTTLE_RATE=120/min      # word endpoints, per user or IP
# CONTENT_SUSTAINED_THROTTLE_RATE=2000/day
# ADMIN_ENABLED=true
# ADMIN_URL=admin/                   # move admin off the well-known path
# NUM_PROXIES=                       # proxies appending X-Forwarded-For; verify before setting

# After saving, run:
#   chmod +x scripts/setup_neon.sh && ./scripts/setup_neon.sh
# Or manually:
#   python manage.py migrate
#   python manage.py createsuperuser
